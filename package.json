{
  "name": "advance-credit-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Portable cross-chain credit attestations on Creditcoin",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "typecheck": "tsc --noEmit",
    "chains": "tsx scripts/discover-chains.ts",
    "proof:submit": "tsx scripts/prove-and-submit.ts",
    "test:sdk": "node --import tsx --test sdk/test/*.test.ts",
    "test:app": "node --import tsx --test app/test/*.test.ts",
    "preflight": "tsx scripts/preflight.ts",
    "proof:generate": "tsx scripts/generate-proof.ts",
    "example:two-lenders": "tsx sdk/examples/two-lenders.ts",
    "check": "npm run typecheck && npm run build && npm test && npm run test:sdk && npm run test:app",
    "check:app": "npm --prefix app exec -- tsc --noEmit -p tsconfig.json && npm --prefix app run build"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "dotenv": "17.4.2",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  }
}
